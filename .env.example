# Frontend (build-time) configuration. Copy to `.env` and adjust.
# Vite only exposes VITE_-prefixed vars to the client; never put secrets here
# (AI provider keys live in the BACKEND env only).

# Backend origin. Leave empty to stay local-first (stubbed assistant replies).
VITE_API_BASE=http://localhost:8000

# AI provider route: "gemini" (default) or "ollama".
VITE_PROVIDER=gemini
