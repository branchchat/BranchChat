# Frontend (build-time) configuration. Copy to `.env` and adjust.
# Vite only exposes VITE_-prefixed vars to the client; never put secrets here
# (AI provider keys live in the BACKEND env only).

# Backend origin. Leave empty to stay local-first (stubbed assistant replies).
VITE_API_BASE=http://localhost:8000

# Default AI provider route: "gemini" (default) or "ollama". Branches created
# via "Branch with model" override this per request; the model catalog itself
# comes from the backend (GET /api/models).
VITE_PROVIDER=gemini

# PostHog product analytics (client-side). The project API key is a PUBLIC
# key safe to ship in the bundle — but real values still live in gitignored
# `.env`, not here. Get these from PostHog > Settings > Project.
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
# US cloud: https://us.i.posthog.com  |  EU cloud: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
