# Backend (server-only) configuration. Copy to `.env` and adjust.
# SECRETS LIVE ONLY HERE — never in the Vite/frontend env.

# -- Environment --------------------------------------------------------------
ENV=development

# -- Database -----------------------------------------------------------------
# App connection: the least-privilege `app_user` role so RLS enforces.
DATABASE_URL=postgresql+asyncpg://app_user:app_pw@localhost:5432/branchchat
# Admin/direct (session-mode) connection Alembic uses for DDL + policies.
DATABASE_DIRECT_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/branchchat
# Set true behind the Supabase transaction pooler (Supavisor) / PgBouncer.
DB_USE_PGBOUNCER=false
# Set true for Supabase / any TLS-required Postgres.
DB_SSL=false
# Path to the Supabase CA certificate (PEM) for FULL TLS verification of the
# DB connection. Unset = encrypted but unverified (sslmode=require). Download
# the CA from Supabase Dashboard > Settings > Database and set this in prod.
# The CA is committed at supabase/prod-ca-2021.crt and baked into the image:
# DB_SSL_CA_FILE=/app/supabase/prod-ca-2021.crt
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# -- AI providers -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# -- Auth / cookies -----------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret
ANON_IDENTITY_SALT=replace-with-a-different-long-random-secret
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# -- Usage quotas -------------------------------------------------------------
FREE_DAILY_MESSAGE_LIMIT=10
AUTHENTICATED_DAILY_MESSAGE_LIMIT=50
AUTHENTICATED_CODE_DAILY_MESSAGE_LIMIT=10

# -- CORS / hosts (comma-separated) ------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*
TRUST_PROXY_FORWARDED_IP=false

# -- Analytics ----------------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# -- Legacy -------------------------------------------------------------------
ENABLE_LEGACY_TREE_API=false
